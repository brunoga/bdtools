# ── mvctools image ───────────────────────────────────────────────────────────
#
# Multi-architecture: everything here is built from source or packaged for every
# architecture, so this image works on amd64 and on arm64 (Apple Silicon, a
# Raspberry Pi 4/5).
#
# The demuxer (Blu-ray and Matroska), the MVC decoder and the Matroska muxer
# are part of mvctools itself (pure Go, with assembly kernels on amd64), and a
# GPU is driven through its own library, so the toolchain is the software
# encoders and ffmpeg (software half-SBS, and GPUs without their library).

# ── Go build ──────────────────────────────────────────────────────────────────
FROM --platform=$BUILDPLATFORM golang:1.27-alpine AS gobuild
ARG TARGETARCH
ARG TARGETVARIANT
ARG VERSION=dev
WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN GOARM="${TARGETVARIANT#v}" CGO_ENABLED=0 GOOS=linux GOARCH=$TARGETARCH \
    go build -ldflags="-s -w -X main.version=${VERSION}" -o mvctools ./cmd/mvctools

# ── Runtime ───────────────────────────────────────────────────────────────────
FROM alpine:latest

# x264 and x265 are both installed: the codec is chosen per run (--codec), and
# an image that carried only one would fail --check for the other.
RUN apk --no-cache add ca-certificates tzdata ffmpeg x264 x265

COPY --from=gobuild /build/mvctools /usr/local/bin/mvctools

# Where a caller mounts the source and the destination library.
VOLUME ["/media"]

ENTRYPOINT ["/usr/local/bin/mvctools"]
CMD ["--check"]
